  },
  "homepage": "https://github.com/roshanrajUI/Glow_BY_Rishi_API#readme",
  "devDependencies": {
    "@types/node": "^24.7.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "hono": "^4.9.8",
    "joi": "^18.0.2",
    "resend": "^6.25.0"
  }

{
  "name": "glow_by_rishi_api",
  "version": "1.0.0",
  "description": "It is a website for a beautican",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 3000",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 execute glow-by-rishi-db --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute glow-by-rishi-db --remote --file=./schema.sql",
    "db:seed:local": "wrangler d1 execute glow-by-rishi-db --local --file=./seed-data.sql"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roshanrajUI/Glow_BY_Rishi_API.git"
  },
  "keywords": [],

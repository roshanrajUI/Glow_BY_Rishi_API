{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "glow-by-rishi-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "glow-by-rishi-db",
      "database_id": "aa231155-be89-4061-a442-db87b4733690"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "glow-by-rishi-uploads"
    }
  ],
  // NOTE: custom domain route disabled until glowbyrishi.in is added as a
  // Cloudflare zone on this account. Once DNS is managed here, re-add:
  // "routes": [{ "pattern": "api.glowbyrishi.in", "custom_domain": true }]
  "workers_dev": true
}

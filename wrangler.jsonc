{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "glow-by-rishi-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "glow-by-rishi-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "glow-by-rishi-uploads"
    }
  ],
  "routes": [
    {
      "pattern": "api.glowbyrishi.in",
      "custom_domain": true
    }
  ],
  "workers_dev": true
}
